NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_NAME=Robust Gifting
# Server-only. Required for admin-created client portal logins.
# Never expose this to the browser. Do not use NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Used to send transactional email (password reset) via Resend instead of Supabase's built-in mailer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Robust Gifting <no-reply@viralinboundnotifications.com>
