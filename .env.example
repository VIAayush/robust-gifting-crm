NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_NAME=Robust Gifting
# Server-only. Required for admin-created client portal logins.
# Never expose this to the browser. Do not use NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Used to send transactional email (password reset) via Resend instead of Supabase's built-in mailer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Robust Gifting <no-reply@viralinboundnotifications.com>

# B2C checkout payment provider: "demo" (default, no credentials needed) or "payu".
PAYMENT_PROVIDER=demo
# Server-only PayU India hosted-checkout credentials. Leave unset to stay on
# Demo Payment Mode — the checkout falls back automatically. Never expose
# these as NEXT_PUBLIC_* or in client code.
PAYU_KEY=
PAYU_SALT=
# "test" or "production" — defaults to "test" when unset.
PAYU_ENVIRONMENT=test
