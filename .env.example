NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_NAME=Robust Gifting
# Server-only. Required for admin-created client portal logins.
# Never expose this to the browser. Do not use NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Used to send transactional email (password reset) via Resend instead of Supabase's built-in mailer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Robust Gifting <no-reply@viralinboundnotifications.com>

# B2C checkout payment provider: "demo" (default, no credentials needed) or "payu".
PAYMENT_PROVIDER=demo
# Server-only PayU India hosted-checkout credentials. Leave unset to stay on
# Demo Payment Mode — the checkout falls back automatically. Never expose
# these as NEXT_PUBLIC_* or in client code.
PAYU_KEY=
PAYU_SALT=
# "test" or "production" — defaults to "test" when unset.
PAYU_ENVIRONMENT=test
# PayU redirects the shopper back to <site>/api/payments/payu/callback. Nothing
# else to configure in code; add that URL as an allowed return URL in the PayU dashboard.

# WhatsApp notifications via Meta WhatsApp Cloud API (server-only).
# Leave blank and every notification is still generated and logged in
# CRM > Notifications as "Skipped" — nothing breaks. Fill these in and new
# order / payment / sample events start sending automatically.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional. Defaults to v21.0.
WHATSAPP_API_VERSION=
# "true" to send pre-approved templates (needed for business-initiated messages
# outside WhatsApp's 24h service window). Template names and parameter order are
# listed in src/lib/notifications/templates.ts — register them with those names.
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional comma-separated staff numbers that receive every new-order / sample alert
# (in addition to the assigned staff member's profile phone), e.g. 9876543210,9123456789
NOTIFY_STAFF_PHONES=
# Set to "false" to pause all outbound notifications without removing credentials.
NOTIFICATIONS_ENABLED=true
# Optional. Enables GET /api/notifications/dispatch (Authorization: Bearer <value>)
# for a scheduler to retry pending notifications.
CRON_SECRET=
